APP_PORT=8000
APP_ORIGIN=http://localhost:8000
ENV_NAME=dev

# Leave unset to keep the local database unencrypted. Set it to an
# environment's key (see tasks/setup-remote/README.md) to read a database
# restored from staging or prod.
# KV_ENCRYPTION_KEY=

# OpenTelemetry for local development.
OTEL_DENO=false
OTEL_SERVICE_NAME=hobproj-dev
OTEL_SERVICE_VERSION=dev
OTEL_EXPORTER_OTLP_PROTOCOL=console
